#!/usr/bin/env bash
set -eu
fixture_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
tck_state=$(mktemp -d /tmp/tether-acp-tck-state.XXXXXX)
export TETHER_WORKSPACE_ROOT=/tmp
export TETHER_DATA_DIR="$tck_state"
export TETHER_AGENTS
TETHER_AGENTS=$(jq -cn --arg fixture "$fixture_root/tests/fixtures/acp" --arg state "$tck_state" '["codex","claude"] | map({id:.,command:$fixture,args:[.,($state + "/" + .)]})')
exec "$fixture_root/target/debug/tether" --stdio
