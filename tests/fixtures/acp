#!/usr/bin/env bash
set -eu
agent=$1
state=$2
mkdir -p "$state"
reply() { jq -cn --argjson id "$request_id" --argjson result "$1" '{jsonrpc:"2.0",id:$id,result:$result}'; }
error() { jq -cn --argjson id "$request_id" --arg message "$1" '{jsonrpc:"2.0",id:$id,error:{code:-32602,message:$message}}'; }
update() { jq -cn --arg sid "$sid" --argjson update "$1" '{jsonrpc:"2.0",method:"session/update",params:{sessionId:$sid,update:$update}}'; }
config() {
  model=$(jq -r '.model // "small"' "$state/$sid.json")
  effort=$(jq -r '.effort // "low"' "$state/$sid.json")
  jq -cn --arg model "$model" --arg effort "$effort" '[{id:"model",name:"Model",category:"model",type:"select",currentValue:$model,options:[{value:"small",name:"Small"},{value:"large",name:"Large"}]},{id:"effort",name:"Reasoning",category:"thought_level",type:"select",currentValue:$effort,options:[{value:"low",name:"Low"},{value:"high",name:"High"}]}]'
}
modes() {
  mode=$(jq -r '.mode // "ask"' "$state/$sid.json")
  jq -cn --arg mode "$mode" '{currentModeId:$mode,availableModes:[{id:"ask",name:"Ask"},{id:"code",name:"Code"}]}'
}
pending=''

while IFS= read -r line; do
  printf '%s\n' "$line" >> "$state/requests.jsonl"
  request_id=$(jq -c '.id // null' <<< "$line")
  method=$(jq -r '.method // ""' <<< "$line")
  sid=$(jq -r '.params.sessionId // ""' <<< "$line")
  case "$method" in
    initialize)
      if [ -f "$state/no-close" ]; then close='{}'; else close='{"close":{}}'; fi
      reply "$(jq -cn --argjson close "$close" '{protocolVersion:1,agentCapabilities:{loadSession:true,promptCapabilities:{image:true,embeddedContext:true},sessionCapabilities:({list:{}} + $close)}}')"
      ;;
    session/new)
      count=$(cat "$state/counter" 2>/dev/null || printf 0)
      count=$((count + 1)); printf '%s' "$count" > "$state/counter"
      sid="$agent-$count"
      jq --arg sid "$sid" '.params + {sessionId:$sid}' <<< "$line" > "$state/$sid.json"
      update '{"sessionUpdate":"available_commands_update","availableCommands":[{"name":"compact","description":"Compact conversation"}]}'
      reply "$(jq -cn --arg sid "$sid" --argjson config "$(config)" '{sessionId:$sid,configOptions:$config,modes:{currentModeId:"ask",availableModes:[{id:"ask",name:"Ask"},{id:"code",name:"Code"}]}}')"
      ;;
    session/list)
      if [ -f "$state/fail-list" ]; then error 'native catalog unavailable'; continue; fi
      shopt -s nullglob
      files=("$state/"*.json)
      sessions=$(jq -s '[.[] | select(has("sessionId") and has("cwd")) | {sessionId,cwd,title:(.title // "Fixture session"),updatedAt,_meta}]' "${files[@]}" </dev/null)
      if [ -f "$state/duplicate-list" ]; then sessions=$(jq '. + .' <<< "$sessions"); fi
      offset=$(jq -r '.params.cursor // "0"' <<< "$line")
      size=$(cat "$state/page-size" 2>/dev/null || printf 10000)
      reply "$(jq -cn --argjson sessions "$sessions" --argjson offset "$offset" --argjson size "$size" '{sessions:$sessions[$offset:($offset+$size)]} + (if ($offset+$size)<($sessions|length) then {nextCursor:(($offset+$size)|tostring)} else {} end)')"
      ;;
    session/load)
      if [ ! -f "$state/$sid.json" ]; then error 'unknown session'; continue; fi
      if [ -f "$state/$sid.history" ]; then
        while IFS= read -r item; do update "$item"; done < "$state/$sid.history"
      fi
      reply "$(jq -cn --argjson config "$(config)" --argjson modes "$(modes)" '{configOptions:$config,modes:$modes}')"
      ;;
    session/close)
      close_id=$request_id
      if [ -n "$pending" ] && [ "$sid" = "$pending_sid" ]; then
        request_id=$pending; pending=''; reply '{"stopReason":"cancelled"}'
      fi
      request_id=$close_id
      reply '{}'
      ;;
    session/set_mode)
      mode=$(jq -r '.params.modeId' <<< "$line")
      if [ "$mode" != ask ] && [ "$mode" != code ]; then error 'invalid mode'; continue; fi
      jq --arg mode "$mode" '.mode=$mode' "$state/$sid.json" > "$state/mode.tmp"
      mv "$state/mode.tmp" "$state/$sid.json"
      reply '{}'
      ;;
    session/set_config_option)
      key=$(jq -r '.params.configId' <<< "$line")
      value=$(jq -r '.params.value' <<< "$line")
      if { [ "$key" = model ] && { [ "$value" = small ] || [ "$value" = large ]; }; } || { [ "$key" = effort ] && { [ "$value" = low ] || [ "$value" = high ]; }; }; then
        jq --arg key "$key" --arg value "$value" '.[$key]=$value | if $key == "model" then .effort="low" else . end' "$state/$sid.json" > "$state/config.tmp"
        mv "$state/config.tmp" "$state/$sid.json"
        options=$(config)
        update "$(jq -cn --argjson options "$options" '{sessionUpdate:"config_option_update",configOptions:$options}')"
        reply "$(jq -cn --argjson options "$options" '{configOptions:$options}')"
      else error 'invalid config value'; fi
      ;;
    session/prompt)
      text=$(jq -r '[.params.prompt[] | select(.type == "text") | .text] | join("\n")' <<< "$line")
      if [[ "$text" == *auth-error* ]]; then
        jq -cn --argjson id "$request_id" '{jsonrpc:"2.0",id:$id,error:{code:-32000,message:"Authentication required",data:{provider:"fixture"}}}'
        continue
      fi
      if [[ "$text" == *crash* ]]; then exit 7; fi
      if [[ "$text" == *failure* ]]; then error 'fixture failed before completion'; continue; fi
      # Native user echoes intentionally contain the handover. Tether must retain
      # the authored input separately, without leaking the seed into its replay.
      user=$(jq -cn --arg text "$text" '{sessionUpdate:"user_message_chunk",content:{type:"text",text:$text}}')
      update "$user"
      printf '%s\n' "$user" >> "$state/$sid.history"
      if [[ "$text" == *slow* ]]; then pending=$request_id; pending_sid=$sid; continue; fi
      update '{"sessionUpdate":"agent_thought_chunk","content":{"type":"text","text":"thinking"}}'
      update '{"sessionUpdate":"plan","entries":[{"content":"Inspect repository","priority":"medium","status":"completed"}]}'
      update '{"sessionUpdate":"tool_call","toolCallId":"tool-1","title":"Read file","kind":"read","status":"in_progress","rawInput":{"path":"README.md"},"locations":[{"path":"README.md","line":1}]}'
      update '{"sessionUpdate":"tool_call_update","toolCallId":"tool-1","status":"completed","content":[{"type":"diff","path":"README.md","oldText":"a","newText":"b"}]}'
      assistant='{"sessionUpdate":"agent_message_chunk","messageId":"answer","content":{"type":"text","text":"hello"}}'
      update "$assistant"
      printf '%s\n' "$assistant" >> "$state/$sid.history"
      if [[ "$text" == *limit* ]]; then reply '{"stopReason":"max_tokens"}'; else reply '{"stopReason":"end_turn"}'; fi
      ;;
    session/cancel)
      if [ -n "$pending" ] && [ "$sid" = "$pending_sid" ]; then
        request_id=$pending; pending=''; reply '{"stopReason":"cancelled"}'
      fi
      ;;
    *) error 'unsupported method';;
  esac
done
